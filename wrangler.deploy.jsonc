{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "take-a-seat-platform",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    {
      "pattern": "takeaseatwith.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    },
    {
      "pattern": "www.takeaseatwith.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsudGFrZWFzZWF0d2l0aC5jb20k",
    "TAKE_A_SEAT_PHONE_SIGN_IN_ENABLED": "false",
    "NEXT_PUBLIC_SITE_URL": "https://takeaseatwith.com",
    "TAKE_A_SEAT_ADMIN_EMAILS": "annabelflip1@gmail.com",
    "TAKE_A_SEAT_APPLICATION_RECIPIENT": "annabelflip1@gmail.com",
    "TAKE_A_SEAT_EMAIL_FROM": "Take a Seat <applications@takeaseatwith.com>",
    "TAKE_A_SEAT_PLATFORM_FEE_BPS": "1500"
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_TOKEN_ENCRYPTION_KEY",
      "RESEND_API_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "r2_buckets": [{ "binding": "CREATOR_MEDIA", "bucket_name": "take-a-seat-creator-media" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "take-a-seat-platform-db",
      "database_id": "144a50a9-e15d-4fcc-a8eb-7e3bed735895",
      "migrations_dir": "drizzle"
    }
  ]
}
